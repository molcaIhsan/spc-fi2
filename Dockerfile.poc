# Lightweight PoC container -- no Flink, no Maven artifacts to resolve (that's
# what broke the earlier Flink-based Dockerfile: a guessed JAR version that
# turned out not to exist). Just Python + two pip packages, running
# poc_consumer.py, which reuses the exact same tested detector/preprocessing/
# message_parser/models modules unmodified.
FROM python:3.12-slim

WORKDIR /app

# kafka-python==2.0.2 (the long-standing pin most tutorials use) is broken on
# Python 3.12 -- its vendored `six` fails with
# "ModuleNotFoundError: No module named 'kafka.vendor.six.moves'". Confirmed
# by actually building and running this image; 3.0.11 (the project resumed
# active releases) imports cleanly on 3.12 -- verified the same way.
#
# libsnappy-dev is required for python-snappy to build -- FI2.data's real
# messages are Snappy-compressed (confirmed by actually running this against
# the live topic: "UnsupportedCodecError: Libraries for snappy compression
# codec not found" without it). kafka-python doesn't bundle codec support.
RUN apt-get update && apt-get install -y --no-install-recommends libsnappy-dev gcc && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir kafka-python==3.0.11 psycopg2-binary==2.9.9 python-snappy==0.7.3

COPY spc/ ./spc/
COPY poc_consumer.py .

# Credentials/config come from environment variables at `docker run` time --
# see README.md / config.py. Nothing hardcoded, nothing baked into the image.
CMD ["python", "poc_consumer.py"]

# --------------------------------------------------------------------------
# Build:
#   docker build -f Dockerfile.poc -t spc-poc:latest .
#
# Run (fill in real Postgres credentials; Kafka bootstrap servers default to
# the two brokers already confirmed reachable from this network):
#   docker run --rm -it \
#     -e SPC_PG_USERNAME=ajinomoto -e SPC_PG_PASSWORD=ajinomoto \
#     spc-poc:latest
# --------------------------------------------------------------------------
